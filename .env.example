# data-layer — non-secret env template
# Real secrets belong in .a0proj/secrets.env (mode 0600, not committed)
# or in a locally-managed .env that is git-ignored.
#
# REQUIRED: every variable marked below with `*required*` must be set
# in the shell, a .env file, or .a0proj/secrets.env before
# `docker compose up`. The compose file refuses to start if any
# required password-bearing variable is unset (see compose `:?` guards).

DATA_LAYER_BASE=/a0/usr/projects/data-layer

# --- postgres submodule (compose uses these directly) ---
# *required*  superuser password for the postgres service
POSTGRES_PASSWORD=
# *required*  tenant password for the agent_zero login role
DATA_LAYER_AGENT_ZERO_PASSWORD=
# Optional overrides (defaults are fine for local dev).
POSTGRES_USER=postgres
POSTGRES_DB=postgres
DATA_LAYER_POSTGRES_DSN=postgresql://postgres@localhost:5432/postgres

# --- redis submodule ---
# Optional: set if you put Redis behind auth.
DATA_LAYER_REDIS_URL=redis://localhost:6379/0

# --- falkordb submodule ---
# Optional: set if you put FalkorDB behind auth.
DATA_LAYER_FALKORDB_URL=bolt://localhost:7687
DATA_LAYER_FALKORDB_DATABASE=default

# --- adapter submodule (currently A0) ---
DATA_LAYER_ADAPTERS_A0_A0_PLUGINS_DIR=/a0/usr/plugins
DATA_LAYER_ADAPTERS_A0_A0_VENV=/opt/venv-a0

# --- personal PAT (optional; only needed by private-repo tooling) ---
# Leave blank in shared environments.
GITHUB_PAT=
