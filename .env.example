# data-layer — non-secret env template
# Real secrets belong in .a0proj/secrets.env (mode 0600, not committed).

# Root of this repo. Override only if you symlink the bootstrap elsewhere.
DATA_LAYER_BASE=/a0/usr/projects/data-layer

# --- postgres submodule ---
DATA_LAYER_POSTGRES_DSN=postgresql://postgres@localhost:5432/postgres

# --- redis submodule ---
DATA_LAYER_REDIS_URL=redis://localhost:6379/0

# --- falkordb submodule ---
DATA_LAYER_FALKORDB_URL=bolt://localhost:7687
DATA_LAYER_FALKORDB_DATABASE=default

# --- adapter submodule (currently A0) ---
DATA_LAYER_ADAPTERS_A0_A0_PLUGINS_DIR=/a0/usr/plugins
DATA_LAYER_ADAPTERS_A0_A0_VENV=/opt/venv-a0

GITHUB_PAT=