#!/usr/bin/env bash
# data-layer/bootstrap — single entry point for the data-layer umbrella.
#
# Subcommands:
#   postgres    delegate to data-layer-postgres/lib/install.sh
#   redis       delegate to data-layer-redis/lib/install.sh
#   falkordb    delegate to data-layer-falkordb/lib/install.sh
#   adapters    delegate to data-layer-adapters/bootstrap
#   seed        apply framework-specific DB seed rows (post-schema)
#   all         schema install + adapter seed for every submodule
#   verify      run verify for every submodule
#   status      run status for every submodule
#   help        show this message
#
# Order matters: schema (postgres install) must run before any adapter
# seed, since seed rows reference postgres tables.

set -euo pipefail

SOURCE="${BASH_SOURCE[0]:-$0}"
SUBDIR="$(cd "$(dirname "$SOURCE")" && pwd)"
DATA_LAYER_BASE="${DATA_LAYER_BASE:-$SUBDIR}"
export DATA_LAYER_BASE

SUBMODULES=(
  "postgres:data-layer-postgres"
  "redis:data-layer-redis"
  "falkordb:data-layer-falkordb"
)
ADAPTERS_ROOT="data-layer-adapters"

usage() {
  cat <<USAGE
Usage: $0 <subcommand> [args]

Subcommands:
  postgres    delegate to data-layer-postgres    schema service
  redis       delegate to data-layer-redis       cache service
  falkordb    delegate to data-layer-falkordb    graph service
  adapters    delegate to data-layer-adapters    adapter collection
  seed        apply framework-specific DB seed rows (requires schema installed)
  all         schema install + adapter seed (skips adapters placeholder)
  verify      run verify for every submodule
  status      run status for every submodule (tolerant of per-service failures)
  help        show this message

Environment:
  DATA_LAYER_BASE   root of this repo (default: this script's directory)
USAGE
}

run_one() {
  local name="$1" path="$2" sub="$3"
  echo "[bootstrap] === $name: $sub ==="
  [[ -d "$DATA_LAYER_BASE/$path" ]] || { echo "[bootstrap FAIL] submodule missing: $path" >&2; return 2; }
  ( cd "$DATA_LAYER_BASE/$path" && bash lib/install.sh "$sub" )
}

run_all() {
  local sub="$1" overall=0
  for entry in "${SUBMODULES[@]}"; do
    name="${entry%%:*}"; path="${entry##*:}"
    if ! run_one "$name" "$path" "$sub"; then overall=$?; fi
  done
  echo "[bootstrap] aggregate $sub overall_status=$overall"
  return $overall
}

run_adapters() {
  local sub="$1"
  if [[ ! -x "$DATA_LAYER_BASE/$ADAPTERS_ROOT/bootstrap" ]]; then
    echo "[bootstrap] no adapters bootstrap found at $ADAPTERS_ROOT/bootstrap" >&2
    return 0
  fi
  ( cd "$DATA_LAYER_BASE/$ADAPTERS_ROOT" && bash bootstrap "$sub" )
}

case "${1:-help}" in
  postgres)   run_one postgres   data-layer-postgres   "${2:-install}" ;;
  redis)      run_one redis      data-layer-redis      "${2:-install}" ;;
  falkordb)   run_one falkordb   data-layer-falkordb   "${2:-install}" ;;
  adapters)
    # Direct delegation. Subcommand defaults to install.
    run_adapters "${2:-install}"
    ;;
  seed)
    # Schema first, then adapter seeds (FK dependency).
    run_one postgres data-layer-postgres install || true
    run_adapters seed
    ;;
  all)
    run_all install
    run_adapters seed
    ;;
  verify)     run_all verify ;;
  status)
    # status is informational — don't fail the umbrella just because one service is down.
    run_all status || true
    run_adapters status || true
    ;;
  help|--help|-h|"") usage ;;
  *)
    echo "unknown subcommand: $1" >&2
    usage >&2
    exit 2
    ;;
esac
