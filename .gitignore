# Local backups
*.tar.gz
*.bak
# === FAISS memory system (per-developer-agent runtime state, not source) ===
# All instances of the FAISS memory artifacts belong to the agent that
# built them, not to the data-layer stack. Exclude from every repo.
.a0proj/memory/
.a0proj/knowledge/
.a0proj/skills/
*.faiss
*.faiss.sha256
*.pkl
embedding.json
knowledge_import.json

# === Recursive .a0proj gitignore ===
# All .a0proj directories in this repo (and their contents) are
# per-developer-agent runtime state managed by the Agent Zero framework.
# The framework regenerates project.json, mcp_servers.json, variables.env,
# and instructions/ on first load — none of it is source-controlled.
**/.a0proj/
**/.a0proj/**


# === Submodule content (each submodule has its own git; umbrella does not track them) ===
# Each submodule ships its own .git/ AND is committed to its own remote.
# The umbrella's role is orchestration; submodule content is not source
# for this repo. Tracking submodule content here causes stale-overlap
# problems when the submodules update their files. Use /a0/usr/projects/
# symlinks or git-submodule-style wiring if umbrella needs to read them.
data-layer-postgres/
data-layer-redis/
data-layer-falkordb/
data-layer-adapters/
