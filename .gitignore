# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
*.so

# Environments
.venv/
venv/
.env
.a0proj/secrets.env

# IDE / OS
.vscode/
.idea/
.DS_Store

# Agent artifacts (memory index is per-project; not source)
*.faiss
*.faiss.sha256
*.pkl
embedding.json
knowledge_import.json

# Recursive .a0proj — runtime metadata regenerates on first load.
# Only project.json + instructions/ are committed; everything else
# (memory, knowledge, skills, plugins, mcp_servers.json, secrets.env,
# variables.env, *.bak) is runtime state or local config.
**/.a0proj/memory/
**/.a0proj/memory/**
**/.a0proj/knowledge/
**/.a0proj/knowledge/**
**/.a0proj/skills/
**/.a0proj/skills/**
**/.a0proj/plugins/
**/.a0proj/plugins/**
**/.a0proj/mcp_servers.json
**/.a0proj/secrets.env
**/.a0proj/variables.env
**/.a0proj/*.bak

# Submodule .git internals (each submodule owns its own .git/).
# The working trees ARE tracked via git submodule pointers;
# do NOT ignore the submodule directories themselves.
**/.git
**/__pycache__

# Local backups
*.tar.gz
*.bak

# Runtime marker files (created after successful bootstrap of a service;
# tracked separately as deployment state, not source).
.qdrant-initialized
**/.qdrant-initialized
.application-built
**/.application-built
**/.service-initialized

# Submodule working trees are tracked via the .gitmodules file and the
# gitlink (mode 160000) registered in the umbrella index. Do NOT
# ignore the submodule directories themselves here — that would
# suppress pointer updates and break fresh clones via `git submodule
# update --init`.
